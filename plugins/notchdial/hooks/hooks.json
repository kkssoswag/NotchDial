{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/notchdial-status.sh working claude-code"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/notchdial-status.sh done claude-code"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/notchdial-status.sh clear claude-code"
          }
        ]
      }
    ]
  }
}
